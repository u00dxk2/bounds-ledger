      "family": "107",
      "verdict": "bears",
      "title": "Matrix multiplication with exponent at most 9/4",
      "leanDoc": "lean/docs/107.md",
      "records": [
        {
          "id": "15a",
          "tag": "formal-proof",
          "statementChecked": true,
          "familyTitle": "Matrix multiplication with exponent at most 9/4",
          "claim": "that the matrix multiplication exponent is below 2.371054886006746 over every field.",
          "statement": {
            "path": "lean/ComparatorChallenges/MatrixFields.lean",
            "theorem": "omega_lt_source_constant",
            "text": "theorem omega_lt_source_constant (F : Type u) [Field F] :\n    Arithmetic.omega F < (2371054886006746 : ℝ) / 10 ^ 15 ∧\n    (2371054886006746 : ℝ) / 10 ^ 15 < (2371056 : ℝ) / 10 ^ 6"
          },
          "match": "Same quantity as this constant: the exponent of the arithmetic cost of multiplying two n × n matrices over a field. The file counts additions, subtractions and multiplications in programs with no division, a narrower model than general arithmetic, so a bound in it is also a bound here. 2.371054886… is below this constant's last-listed upper-bound row.",
          "screenedBy": [
            "claude",
            "codex"
          ]
        },
        {
          "id": "15a",
          "tag": "formal-proof",
          "statementChecked": true,
          "familyTitle": "Matrix multiplication with exponent at most 9/4",
          "claim": "that the matrix multiplication exponent over the complex numbers is at most 9/4 = 2.25.",
          "statement": {
            "path": "lean/ComparatorChallenges/MatrixMultiplication.lean",
            "theorem": "complex_omega_le_nine_quarters",
            "text": "theorem complex_omega_le_nine_quarters :\n    Arithmetic.omega ℂ ≤ (9 : ℝ) / 4"
          },
          "match": "Same quantity, over the complex numbers, in the same model with no division (defined in the file).",
          "screenedBy": [
            "claude",
            "codex"
          ]
        },
        {
          "id": "15b",
          "tag": "formal-proof",
          "statementChecked": true,
          "familyTitle": "Matrix multiplication with exponent at most 9/4",
          "claim": "that the dual matrix multiplication exponent α is greater than 93/200 = 0.465 over the complex numbers.",
          "statement": {
            "path": "lean/ComparatorChallenges/MatrixMultiplication.lean",
            "theorem": "complex_alpha_gt_93_div_200",
            "text": "theorem complex_alpha_gt_93_div_200 :\n    (93 : ℝ) / 200 < Arithmetic.complexAlpha"
          },
          "match": "Same quantity: the file defines α as the supremum of the k in [0, 1] for which multiplying an n × n^k matrix by an n^k × n matrix has exponent 2. Leaving out k > 1 changes nothing, since the exponent is then above 2. 0.465 is above this constant's last-listed lower-bound row.",
          "screenedBy": [
            "claude",
            "codex"
          ]
        }
      ]
    },
